# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
# Allowed values: development | test | production
APP_ENV=development

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
PORT=3001
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Dev and test use different host ports so both Postgres containers can run.
DB_PORT=5432
DB_TEST_PORT=5433

DB_NAME=tarpit
DB_TEST_NAME=tarpit_test

# App uses DB_URL by default and DB_TEST_URL when APP_ENV=test.
# Replace <POSTGRES_USER> and <POSTGRES_PASSWORD> in your local .env.
DB_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/tarpit
DB_TEST_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5433/tarpit_test

# PostgreSQL credentials used by docker compose / local db setup
POSTGRES_USER=
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------
RESEND_API_KEY=
TARPIT_DOMAIN=

# ------------------------------------------------------------------------------
# Authentication (JWT + refresh session)
# ------------------------------------------------------------------------------
# Generate with:
#   openssl rand -hex 64
# Run twice and use different values for each secret.
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=

# Recommended defaults:
# - Access token: 10 minutes
# - Refresh session: 7 days
JWT_ACCESS_TTL_SECONDS=86400	# 24h for now, later 10min when we have refresh tokens
REFRESH_TTL_SECONDS=604800
