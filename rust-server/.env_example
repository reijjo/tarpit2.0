# Environment
APP_ENV=development

# Port
PORT=3001

# Database
# Host ports for local Docker Postgres containers.
# Keep these different because both dev and test DB containers run at the same time.
DB_PORT=5432
DB_TEST_PORT=5433
DB_NAME=tarpit
DB_TEST_NAME=tarpit_test

# App uses DB_URL by default and DB_TEST_URL when APP_ENV=test.
DB_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/tarpit
DB_TEST_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5433/tarpit_test

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=

# Url
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Email service
RESEND_API_KEY=
TARPIT_DOMAIN=
