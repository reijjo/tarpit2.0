generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// User Model
enum Role {
	GUEST
	LEGIT
	PAID
	BOSS
}

model User {
	id				Int				@id @default(autoincrement())
	email			String		@unique
	username	String		@unique
	password	String
	role			Role			@default(GUEST)
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@updatedAt
}
